---
import { contactForm } from "../data/content";

const inputBase =
  "w-full bg-transparent border-0 border-b border-ink/40 px-0 py-2 text-base text-ink focus:outline-none focus:border-brand-green";
---

<section id="contact" class="bg-paper">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-ink text-center">
      {contactForm.heading}
    </h2>

    <form
      class="mt-12 grid gap-x-8 gap-y-10 grid-cols-1 sm:grid-cols-2 md:grid-cols-3"
      action={contactForm.endpoint}
      method="POST"
      data-form="contact"
    >
      {
        contactForm.fields.map((field) => (
          <label
            class:list={[
              "flex flex-col text-sm text-ink",
              !field.half && "md:col-span-3",
            ]}
          >
            <span class="mb-1.5">
              {field.label}
              {field.required && <span class="text-ink ml-0.5">*</span>}
            </span>
            {field.type === "textarea" ? (
              <textarea
                name={field.name}
                required={field.required}
                rows={4}
                class={inputBase + " resize-y"}
              />
            ) : (
              <input
                type={field.type}
                name={field.name}
                required={field.required}
                class={inputBase}
              />
            )}
          </label>
        ))
      }

      <div class="md:col-span-3 flex justify-center pt-4">
        <button
          type="submit"
          class="bg-brand-green text-brand-gold font-display font-bold text-2xl sm:text-3xl px-14 sm:px-16 py-5 sm:py-6 rounded-full shadow-md hover:bg-brand-green-dark hover:shadow-lg transition-all"
        >
          {contactForm.submitLabel}
        </button>
      </div>

      <p
        data-form-confirmation
        hidden
        class="md:col-span-3 text-center text-ink/80 leading-relaxed"
      >
        {contactForm.confirmation}
      </p>
    </form>
  </div>
</section>
