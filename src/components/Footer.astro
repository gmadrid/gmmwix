---
import { Image } from "astro:assets";
import playingCards from "../assets/images/playing-cards.png";
import { footer } from "../data/content";
---

<footer>
  <Image
    src={playingCards}
    alt=""
    widths={[800, 1200, 1800, 2400]}
    sizes="100vw"
    class="w-full aspect-[16/5] sm:aspect-[16/4] object-cover"
  />

  <div class="bg-paper border-t border-black/5">
    <div
      class="mx-auto max-w-6xl px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-ink/60"
    >
      <p>{footer.copyright}</p>
      <p class="italic">{footer.photoCredit}</p>
    </div>
  </div>
</footer>
