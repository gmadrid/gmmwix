---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.jpg";
import { hero } from "../data/content";

const bodyWithLink = hero.body.replace(/\.$/, "");
---

<section id="home" class="bg-paper">
  <Image
    src={heroImage}
    alt="George Madrid performing close-up magic"
    widths={[800, 1200, 1800, 2400]}
    sizes="100vw"
    class="w-full aspect-[16/6] sm:aspect-[16/5] object-cover"
    loading="eager"
    fetchpriority="high"
  />

  <div class="mx-auto max-w-3xl px-6 pt-16 sm:pt-20 pb-4 text-center">
    <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink">
      {hero.headline}
    </h1>
    <p class="mt-4 font-display text-2xl sm:text-3xl text-ink">
      {hero.subheadline}
    </p>
    <p class="mt-8 text-base sm:text-lg leading-relaxed text-ink/85">
      {bodyWithLink},
      <a
        href={hero.ctaHref}
        class="underline underline-offset-4 decoration-2 decoration-brand-gold text-brand-green hover:text-brand-gold transition-colors"
      >
        click here
      </a>
       to discuss your event details.
    </p>
  </div>
</section>
