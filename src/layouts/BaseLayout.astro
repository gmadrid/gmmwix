---
import "../styles/global.css";
import { site } from "../data/content";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.title,
  description = "Boston-based comedy magician George Madrid — strolling close-up magic, family parties, and corporate events that your guests will talk about for years.",
} = Astro.props;

const faviconHref = import.meta.env.BASE_URL.replace(/\/?$/, "/") + "favicon.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-paper text-ink font-body antialiased">
    <slot />
  </body>
</html>
